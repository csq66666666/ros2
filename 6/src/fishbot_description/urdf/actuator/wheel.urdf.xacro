<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">



    <!-- ================= 差速驱动轮 宏定义 =================
         name   : left / right，用来拼出 left_wheel_link / left_wheel_joint
         xyz    : 轮心相对 base_link 的位置（位置偏移只写在这里！）
         radius : 轮子半径，决定轮底（接地）高度
         length : 轮子宽度，沿 Y 轴方向
    -->
    <xacro:macro name="wheel_xacro" params="name xyz radius length">
        <link name="${name}_wheel_link">
            <visual>
                <!-- 圆柱默认轴向是 Z，绕 X 轴转 90° 后轴向变成 Y，轮子才立得起来。
                     这里的 rpy 只管"几何体朝向"，不是位置偏移，所以放在 visual 里是对的，
                     位置偏移依然只由 joint 的 origin 提供，避免偏移被算两遍。 -->
                <origin xyz="0 0 0" rpy="1.57079 0 0"/>
                <geometry>
                    <cylinder radius="${radius}" length="${length}"/>
                </geometry>
                <material name="yellow">
                    <color rgba="1.0 1.0 0.0 0.5"/>
                </material>
            </visual>

            <!-- 碰撞体必须把 rpy="1.57079 0 0" 一起复制过来，
                 否则碰撞圆柱会立着（轴向 Z），轮子在地面上会"陷进去" -->
            <collision>
                <origin xyz="0 0 0" rpy="1.57079 0 0"/>
                <geometry>
                    <cylinder radius="${radius}" length="${length}"/>
                </geometry>
            </collision>
        </link>

        <!-- 驱动轮要能一直转，所以用 continuous（而不是 revolute）
             axis 写在 child link 坐标系里，且 joint 的 origin 没有旋转，
             所以 (0,1,0) 就是绕 base_link 的 Y 轴转。
             左右轮都用 +Y，这样"同号角速度 = 两个轮子同时向前"，符合差速模型的约定 -->
        <joint name="${name}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${name}_wheel_link"/>
            <origin xyz="${xyz}" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
        </joint>
    </xacro:macro>



</robot>
